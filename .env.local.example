# Copie este arquivo para ".env.local" para usar um banco na nuvem (Turso).
# Sem essas variáveis, o app usa automaticamente um arquivo SQLite local
# em data/cartoes.db (ótimo para rodar no seu computador).

TURSO_DATABASE_URL=libsql://seu-banco-sua-org.turso.io
TURSO_AUTH_TOKEN=coloque_aqui_o_token_gerado_pelo_turso
